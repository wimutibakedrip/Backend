{
  "builds": [
    {
      "src": "index.js", 
      "use": "@vercel/node"
    },
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/static-images/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
